# Copiar a .env y completar localmente. Sin credenciales predeterminadas.
# Para una instalación aislada, definir COMPOSE_PROJECT_NAME con un nombre nuevo.
# No reutilizar nombres, puertos ni volúmenes de una instancia existente.
POSTGRES_DB=kitchenware
POSTGRES_USER=kitchenware
POSTGRES_PASSWORD=
APP_KEY=
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:8080
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=5173
# Solo para compose.db-access.yaml; nunca reutilizar el puerto de otra instancia.
POSTGRES_BIND_PORT=55432
